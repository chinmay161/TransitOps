# =====================================================
# TransitOps Vercel Production Environment
# This file serves as a reference for the variables required
# when deploying to Vercel. DO NOT place real production secrets
# in this file. Add these variables directly in the Vercel Dashboard.
# =====================================================

# -----------------------------------------------------
# SECRETS (Required for Vercel deployment)
# -----------------------------------------------------

# PostgreSQL connection string for your production database (e.g., Neon)
DATABASE_URL=

# Better Auth Session Secret (Must be 32+ chars, generated securely)
BETTER_AUTH_SECRET=

# Google OAuth Client Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------
# SYSTEM / PUBLIC VARIABLES
# -----------------------------------------------------

# Override the Better Auth canonical base URL for the deployed frontend.
# Set this to the production frontend domain (e.g., https://usetransitops.vercel.app)
BETTER_AUTH_URL=

# Canonical frontend origin (e.g., https://usetransitops.vercel.app)
FRONTEND_URL=

# Proxy mapping for frontend server-side data fetching.
# This must point to the Vercel rewrite prefix so API requests 
# are correctly forwarded to the backend service.
# Value: /api/backend (or full domain + /api/backend)
NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_API_BASE_URL=/api/backend
