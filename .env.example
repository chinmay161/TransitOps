# =====================================================
# TransitOps Local Development Environment
# Copy this file to .env in the root directory.
# NEVER commit real credentials to version control.
# =====================================================

# -----------------------------------------------------
# SHARED / BACKEND CONFIGURATION
# -----------------------------------------------------
# Node environment
NODE_ENV=development

# Backend Express Server Port
PORT=5000

# PostgreSQL connection string (Required)
# Used by both the Express application and Better Auth
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/transitops

# Better Auth Configuration
# BETTER_AUTH_SECRET must be at least 32 characters long
# Generate locally with: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# In development, BETTER_AUTH_URL should match the frontend origin
BETTER_AUTH_URL=http://localhost:3000

# Canonical frontend origin (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Google OAuth Configuration (Required for login)
# Obtain from Google Cloud Console -> Credentials -> OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Admin Initial Password (Required for first-time admin credential seeding)
# Used only when creating admin accounts that don't yet have credentials.
# Once created, this value is never used again — passwords are never reset on restart.
# NEVER commit a real password to version control.
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# -----------------------------------------------------
# FRONTEND CONFIGURATION (NEXT.JS)
# -----------------------------------------------------
# Base URL for frontend API proxy and API utilities.
# Next.js will automatically inject this during local dev/SSR.
# In local development, the Next.js dev server proxies API routes via next.config.ts
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000
